{
  "name": "@snapshare/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts all",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@snapshare/config": "workspace:*",
    "@snapshare/server-kit": "workspace:*",
    "bullmq": "6.7.6",
    "ioredis": "6.0.0",
    "mongoose": "9.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino": "10.4.0",
    "tsx": "4.23.15"
  }
}
