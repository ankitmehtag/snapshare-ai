{
  "name": "@snapshare/server-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Server-only building blocks shared by api and workers: logging, Mongo/Redis connections, outbox, job queues.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@snapshare/config": "workspace:*",
    "bullmq": "6.7.6",
    "ioredis": "6.0.0",
    "mongoose": "9.12.2",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  }
}
