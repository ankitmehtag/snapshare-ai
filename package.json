{
  "name": "snapshare-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --project tooling && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node tooling/install-hooks.js",
    "test:integration": "turbo run test:integration --concurrency=1",
    "infra:up": "docker compose -f infrastructure/docker/compose.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker/compose.yml down",
    "infra:reset": "docker compose -f infrastructure/docker/compose.yml down -v",
    "migrate": "pnpm --filter @snapshare/api migrate",
    "test:e2e": "pnpm --filter @snapshare/web build && pnpm --filter @snapshare/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
