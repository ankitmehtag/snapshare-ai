# SnapShare AI — local development environment.
# Copy to .env (git-ignored):  cp .env.example .env
# These values only work against the local Docker services (pnpm infra:up).
# Never put production secrets in this file.

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# --- API ---
PORT=4000
# Internal Prometheus port (compose profile `monitoring` scrapes it). 0 disables.
METRICS_PORT=9464
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
# 32+ random chars. Generate: openssl rand -base64 48
CURSOR_SECRET=dev-only-cursor-secret-change-me-0123456789

# --- Auth (Phase 2; API_SPEC §1.2) ---
# Web origin used in email links (verify, reset).
APP_URL=http://localhost:5173
# Ed25519 key for access tokens: REQUIRED in production, optional locally (an
# ephemeral key is generated; refresh tokens keep you signed in across restarts).
# Generate: openssl genpkey -algorithm ed25519 | base64 | tr -d '\n'
# AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KEY_ID=k1
# 32+ random chars. Generate: openssl rand -base64 48
IP_HASH_SECRET=dev-only-ip-hash-secret-change-me-0123456789
# Secure cookies need HTTPS; off for http://localhost, forced on in production.
COOKIE_SECURE=false
# Cloudflare Turnstile: unset = Cloudflare's always-pass TEST secret (refused in production).
# TURNSTILE_SECRET_KEY=
# Breached-password check via HIBP's free k-anonymity API.
HIBP_ENABLED=true

# --- Data services (infrastructure/docker/compose.yml) ---
MONGO_URL=mongodb://127.0.0.1:27017/snapshare?directConnection=true
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=snapshare-dev-qdrant-key

# --- Object storage (SeaweedFS locally; Backblaze B2 in production — ADR-019/023) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=snapshare-dev
S3_SECRET_ACCESS_KEY=snapshare-dev-secret-key
S3_BUCKET_MEDIA=snapshare-media
S3_BUCKET_TMP=snapshare-tmp

# --- Email (Mailpit locally: UI at http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Production: SMTP_USER / SMTP_PASS from the provider (Brevo, Resend or SES — G10).
MAIL_FROM=SnapShare <no-reply@snapshare.local>

# --- Workers ---
WORKER_HEALTH_PORT=4100

# --- ai-service (compose profile `ai`; AI_ARCHITECTURE §10) ---
AI_SERVICE_URL=http://127.0.0.1:8000
# 32+ random chars each, and different from each other. Generate: openssl rand -hex 32
AI_SERVICE_TOKEN=dev-only-ai-service-token-0123456789abcdef
AI_SCOPE_SIGNING_KEY=dev-only-ai-scope-key-0123456789abcdefgh
